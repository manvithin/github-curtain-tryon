{
  "name": "curtain-visualizer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "cap:build": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@react-three/drei": "^9.109.0",
    "@react-three/fiber": "^8.16.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "lucide-react": "^0.408.0",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.4",
    "three": "^0.167.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "vite": "^5.3.4"
  }
}
